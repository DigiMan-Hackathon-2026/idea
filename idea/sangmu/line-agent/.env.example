# local | test | preview | production
APP_ENV=
APP_ORIGIN=

# Server-only TMAP app key for in-app pedestrian routes. Never prefix with
# NEXT_PUBLIC or expose it to browser code.
TMAP_APP_KEY=

# Server-only Public Data Portal key for Seoul Metro elevator status and quick
# exit information. Use the decoded key issued for each environment.
SEOUL_METRO_PUBLIC_DATA_SERVICE_KEY=

# Browser-visible NAVER Maps Web Dynamic Map Client ID. Restrict it to the
# registered web service domains in NAVER Cloud Platform; this is not a secret.
NEXT_PUBLIC_NAVER_MAP_NCP_KEY_ID=

# Local PostgreSQL container settings. Use a unique local-only password.
LOCAL_POSTGRES_DB=
LOCAL_POSTGRES_USER=
LOCAL_POSTGRES_PASSWORD=
LOCAL_POSTGRES_PORT=

# Runtime and migration roles must use separate URLs after role bootstrap.
DATABASE_URL=
# Exact hostname of the dedicated preview PostgreSQL endpoint. The preview
# connection uses a digiman_preview DB, digiman_runtime_preview role, and sslmode=verify-full.
PREVIEW_DATABASE_HOST=
DATABASE_DIRECT_URL=
TEST_DATABASE_URL=

# JSON object of one active and at most one previous base64url 32-byte key.
SESSION_TOKEN_PEPPERS=
SESSION_TOKEN_ACTIVE_VERSION=

# ── LINE agent ──────────────────────────────────────────────────────────────
# LINE official account (Messaging API channel). Without them the webhook
# answers 503 and only the local simulator (/dev/line-agent) works.
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# Random 32+ byte secrets. Keys hash LINE ids; links sign the Korean booking card.
# Required in production; generated per process locally when empty.
LINE_AGENT_KEY_SECRET=
LINE_AGENT_LINK_SECRET=
# off | simulator | twilio (simulator by default outside production).
LINE_AGENT_CALLS=
# JSON {"demo-shop-a":"+8210..."}: phone refs → numbers of people who agreed to
# take test calls. Only these numbers can ever be dialled.
LINE_AGENT_PHONE_ALLOWLIST=
# Optional: start the agent's clock at this time for rehearsals, e.g. 2026-11-29T17:30:00+09:00
LINE_AGENT_DEMO_NOW=
# memory (default, lost on restart) | postgres (DATABASE_URL, migration 0009).
LINE_AGENT_STORE=
# Set to 1 to enable the simulator on a preview deployment (never production).
LINE_AGENT_SIMULATOR=
# The simulator answers only on localhost. To open it through a tunnel, set a
# 16+ char token and use /dev/line-agent?token=… (it can place real calls in twilio mode).
LINE_AGENT_SIMULATOR_TOKEN=

# Twilio (paid account: trial accounts block <Stream> and foreign calls).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Voice bridge (services/voice-bridge): public host Twilio streams to, and a
# 16+ char secret shared with the app for attempt tokens.
VOICE_BRIDGE_PUBLIC_HOST=
VOICE_BRIDGE_SECRET=
# Where the bridge reaches the app (same machine: http://localhost:3000).
VOICE_BRIDGE_APP_URL=
OPENAI_API_KEY=
