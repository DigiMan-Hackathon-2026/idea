{
  "name": "digiman",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed:demo": "node --env-file-if-exists=.env.local scripts/db/seed-demo.mjs",
    "db:seed:hackathon": "node --env-file-if-exists=.env.local scripts/db/seed-digiman-hackathon.mjs",
    "db:seed:myeongdong-kyoja": "node --env-file-if-exists=.env.local scripts/db/seed-myeongdong-kyoja.mjs",
    "db:seed:museum-room": "node --env-file-if-exists=.env.local scripts/db/seed-museum-room-of-contemplation.mjs",
    "db:seed:oliveyoung-shopping": "node --env-file-if-exists=.env.local scripts/db/seed-seongsu-oliveyoung-shopping.mjs",
    "db:seed:oliveyoung-skin": "node --env-file-if-exists=.env.local scripts/db/seed-seongsu-oliveyoung-skin-consulting.mjs",
    "db:seed:irotomo": "node --env-file-if-exists=.env.local scripts/db/seed-yeouido-irotomo-first-meetup.mjs",
    "db:seed:somugwan": "node --env-file-if-exists=.env.local scripts/db/seed-seongsu-somugwan-solo-gukbap.mjs",
    "audit:dependencies": "pnpm audit --audit-level moderate",
    "verify:docs": "python3 scripts/verify_all.py",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm verify:docs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "postcss": "8.5.33",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  }
}
