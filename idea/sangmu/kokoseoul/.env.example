# local | test | preview | production
APP_ENV=

# Local PostgreSQL container settings. Use a unique local-only password.
LOCAL_POSTGRES_DB=
LOCAL_POSTGRES_USER=
LOCAL_POSTGRES_PASSWORD=
LOCAL_POSTGRES_PORT=

# Runtime and migration roles must use separate URLs after role bootstrap.
DATABASE_URL=
DATABASE_DIRECT_URL=
TEST_DATABASE_URL=

# JSON object of one active and at most one previous base64url 32-byte key.
SESSION_TOKEN_PEPPERS=
SESSION_TOKEN_ACTIVE_VERSION=
